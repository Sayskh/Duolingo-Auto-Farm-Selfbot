# Duolingo session token. Treat this value like a password.
JWT=replace_with_your_jwt

# Timezone used for goals and badge progress requests.
TIMEZONE=Asia/Jakarta

# Automation settings. Review account impact before enabling actions.
XP_SESSIONS=5
AUTO_FREEZE=false
AUTO_CLAIM_REWARDS=false
AUTO_CLAIM_BADGES=false
AUTO_SUPER=false
# Duolingo for Schools classroom code (6 chars) to activate Super Duolingo natively
CLASSROOM_CODE=
AUTO_LEADERBOARD_TOP=false

# Discord Webhook URL for run reports and alert notifications
WEBHOOK_URL=
